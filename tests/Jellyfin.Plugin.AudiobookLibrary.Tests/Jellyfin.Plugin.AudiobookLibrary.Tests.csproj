<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- JPRM runs dotnet publish over the whole solution, this keeps test DLLs out of the release build -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- Same versions Jellyfin 12.1 uses for its own tests -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The plugin leaves out Jellyfin's DLLs because the server has them, tests that touch Jellyfin types need their own copy -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
  </ItemGroup>

  <!-- Real ffmpeg output and chapter times from The Lost Metal, used to check the silence tuning -->
  <ItemGroup>
    <None Update="Silences\TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Plugin.AudiobookLibrary\Jellyfin.Plugin.AudiobookLibrary.csproj" />
  </ItemGroup>

</Project>
