# Copy to scripts/deploy-test.env (git-ignored) and fill in for your setup
# Deploys run on a relay machine that can SSH to both the build machine and the test server

# SSH host names as the relay machine knows them, from its ~/.ssh/config
RELAY_WORKSPACE_HOST=workspace
RELAY_SERVER_HOST=jellyfin-server

# The repo on the build machine, as that machine's shell sees it
WORKSPACE_REPO=~/jellyfin-audiobooks

# Jellyfin container name on the test server
TEST_CONTAINER=jellyfin

# The plugins folder inside the container, /config/data/plugins for the linuxserver image
TEST_PLUGINS_DIR=/config/data/plugins

# The user Jellyfin runs as inside the container, abc for the linuxserver image
TEST_CONTAINER_USER=abc

# Server URL as seen from the build machine
TEST_SERVER_URL=http://192.0.2.10:8096

# Optional, lets the script wait until the server reports the new version
TEST_API_KEY=
